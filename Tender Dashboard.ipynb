# ------------------- DASHBOARD ROUTE -------------------
@app.route("/")
def index():
    df = load_parquet_from_blob()

    # Remove unwanted columns
    remove_cols = [
        'document_format','published_date','document_language','tag',
        'language','document language','tender_link','delivery_point',
        'parties','status','document_type','value_currency'
    ]
    df = df.drop(columns=[c for c in remove_cols if c in df.columns], errors='ignore')

    # Filters
    title = request.args.get("title", "")
    tender_number = request.args.get("tender_number", "")
    category_col = 'category'
    selected_categories = request.args.getlist("category")
    from_date_str = request.args.get("from_date", "")
    to_date_str = request.args.get("to_date", "")

    df_filtered = df.copy()

    # Filter by tender_number if provided
    if tender_number:
        df_filtered = df_filtered[df_filtered['tender_number'] == tender_number]

    # Filter by title
    if title:
        df_filtered = df_filtered[df_filtered["title"].str.contains(title, case=False, na=False)]

    # Filter by category
    if selected_categories and category_col in df_filtered.columns:
        df_filtered = df_filtered[df_filtered[category_col].isin(selected_categories)]

    # Filter by closing date
    date_col = 'closing_date'  # replace with your actual closing date column name
    if date_col in df_filtered.columns:
        df_filtered[date_col] = pd.to_datetime(df_filtered[date_col], errors='coerce')
        if from_date_str:
            from_date = pd.to_datetime(from_date_str)
            df_filtered = df_filtered[df_filtered[date_col] >= from_date]
        if to_date_str:
            to_date = pd.to_datetime(to_date_str)
            df_filtered = df_filtered[df_filtered[date_col] <= to_date]

    # Prepare table data
    table_columns = df_filtered.columns.tolist()
    table_data = df_filtered.head(50).to_dict(orient="records")

    # KPIs
    now = datetime.now()
    if date_col in df_filtered.columns:
        active_tenders = df_filtered[df_filtered[date_col] >= now].shape[0]
        closed_tenders = df_filtered[df_filtered[date_col] < now].shape[0]
        tenders_this_month = df_filtered[
            (df_filtered[date_col].dt.year == now.year) &
            (df_filtered[date_col].dt.month == now.month)
        ].shape[0]
    else:
        active_tenders = df_filtered.shape[0]
        closed_tenders = 0
        tenders_this_month = df_filtered.shape[0]

    # Categories for filter checkboxes
    categories = sorted(df[category_col].dropna().unique()) if category_col in df.columns else []

    return render_template_string(
        dashboard_template,
        title=title,
        categories=categories,
        selected_categories=selected_categories,
        from_date=from_date_str,
        to_date=to_date_str,
        active_tenders=active_tenders,
        tenders_this_month=tenders_this_month,
        closed_tenders=closed_tenders,
        table_columns=table_columns,
        table_data=table_data
    )


# ------------------- ASSIGN TENDERS ROUTE -------------------
@app.route("/assign_tenders", methods=["GET", "POST"])
def assign_tenders_route():
    df = load_parquet_from_blob()

    if os.path.exists(CSV_FILE):
        assigned_df = pd.read_csv(CSV_FILE, dtype=str)
        assigned_tenders = dict(zip(assigned_df['tender_number'], assigned_df['salesperson']))
    else:
        assigned_tenders = {}

    if request.method == "POST":
        tender_number = request.form.get("tender_number")
        salesperson = request.form.get("salesperson")
        assigned_tenders[tender_number] = salesperson
        assigned_df = pd.DataFrame(list(assigned_tenders.items()), columns=['tender_number', 'salesperson'])
        os.makedirs(os.path.dirname(CSV_FILE), exist_ok=True)
        assigned_df.to_csv(CSV_FILE, index=False)

    table_data = df[['tender_number']].rename(columns={'tender_number': 'number'}).head(50).to_dict(orient="records")
    
    return render_template_string(
        assign_template,
        table_data=table_data,
        assigned_tenders=assigned_tenders
    )

